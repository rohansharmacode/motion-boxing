# ============================================================================
# Client (Vite). Copy to .env in the repo root. Only VITE_* vars reach the browser.
# ============================================================================
# API server base URL. Empty = mock data, no network. Local server: http://localhost:3001
VITE_API_URL=
# true = force mock data even when VITE_API_URL is set
VITE_USE_MOCK=false
# Round length in ms (default 40000)
VITE_ROUND_MS=40000

# ============================================================================
# Server (server/.env). Full commented reference: server/.env.example
# Never commit real values. Never put these in VITE_* vars.
# ============================================================================
SNOWFLAKE_MOCK=1
PORT=3001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_USERNAME=
SNOWFLAKE_AUTHENTICATOR=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_PRIVATE_KEY_PWD=
SNOWFLAKE_JWT=
SNOWFLAKE_ROLE=
SNOWFLAKE_READONLY_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_POOL_MAX=4
SNOWFLAKE_QUERY_TIMEOUT_MS=20000

CORTEX_MODEL=mistral-large2
CORTEX_MODELS=
CORTEX_USER=
COACH_TIMEOUT_MS=8000
ASK_CORTEX_TIMEOUT_MS=15000
ASK_QUERY_TIMEOUT_MS=10000
ASK_ROW_LIMIT=100

EVENTS_MAX_BATCH=500
EVENTS_INSERT_CHUNK=500
EVENTS_MAX_QUEUE=50000
EVENTS_ACK_WAIT_MS=50
EVENTS_RETRY_BASE_MS=250
EVENTS_RETRY_MAX_MS=15000
EVENTS_MAX_ATTEMPTS=8
SESSION_END_FLUSH_WAIT_MS=5000
