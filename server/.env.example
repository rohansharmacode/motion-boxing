# Motion Boxing server configuration. Copy to server/.env and fill in.
# Variable names here are the canonical ones (README-snowflake.md refers to this file).

# --- Mode -------------------------------------------------------------------------------------
# 1 = in-memory repository + canned Cortex replies; no Snowflake credentials needed.
# 0 = real Snowflake (fill in the section below). A shell variable overrides this file.
SNOWFLAKE_MOCK=0

# --- HTTP -------------------------------------------------------------------------------------
PORT=3001
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Snowflake connection (ignored when SNOWFLAKE_MOCK=1) --------------------------------------
# Account identifier, e.g. myorg-myaccount (no .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=MOTION_APP_USER
# Key-pair auth (recommended; see sql/setup.sql for the openssl commands). Either a path
# (relative to the directory you start the server from, normally server/), e.g. ./rsa_key.p8 ...
SNOWFLAKE_PRIVATE_KEY_PATH=
# ...or the PEM itself on one line with literal \n sequences:
SNOWFLAKE_PRIVATE_KEY=
# Only if the private key is encrypted:
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Password auth instead of a key (not allowed for TYPE=SERVICE users):
SNOWFLAKE_PASSWORD=

SNOWFLAKE_ROLE=MOTION_APP_ROLE
SNOWFLAKE_WAREHOUSE=MOTION_WH
SNOWFLAKE_DATABASE=MOTION_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_POOL_MAX=4
SNOWFLAKE_QUERY_TIMEOUT_MS=20000

# SELECT-only role used ONLY by POST /api/ask (text-to-SQL). If it does not exist, /api/ask
# answers 502/503 and everything else keeps working. Create it as ACCOUNTADMIN with:
#   CREATE ROLE IF NOT EXISTS MOTION_READONLY_ROLE;
#   GRANT USAGE ON WAREHOUSE MOTION_WH TO ROLE MOTION_READONLY_ROLE;
#   GRANT USAGE ON DATABASE MOTION_DB TO ROLE MOTION_READONLY_ROLE;
#   GRANT USAGE ON SCHEMA MOTION_DB.PUBLIC TO ROLE MOTION_READONLY_ROLE;
#   GRANT SELECT ON ALL TABLES IN SCHEMA MOTION_DB.PUBLIC TO ROLE MOTION_READONLY_ROLE;
#   GRANT SELECT ON ALL VIEWS IN SCHEMA MOTION_DB.PUBLIC TO ROLE MOTION_READONLY_ROLE;
#   GRANT SELECT ON ALL DYNAMIC TABLES IN SCHEMA MOTION_DB.PUBLIC TO ROLE MOTION_READONLY_ROLE;
#   GRANT ROLE MOTION_READONLY_ROLE TO USER MOTION_APP_USER;
SNOWFLAKE_READONLY_ROLE=MOTION_READONLY_ROLE

# --- Cortex -----------------------------------------------------------------------------------
# Any model available to SNOWFLAKE.CORTEX.COMPLETE in your region (e.g. mistral-large2,
# llama3.1-70b, claude-3-5-sonnet). The coach card falls back to a fixed card on any failure.
CORTEX_MODEL=mistral-large2
# Contract: 8 s
COACH_TIMEOUT_MS=8000
ASK_CORTEX_TIMEOUT_MS=15000
ASK_QUERY_TIMEOUT_MS=10000
ASK_ROW_LIMIT=100

# --- Demo latency -----------------------------------------------------------------------------
# /api/session/end answers within this many ms. If Cortex is slower, it returns a provisional
# card with warming_up:true and finishes the real card in the background
# (GET /api/session/:id/coach). 0 = always wait (up to COACH_TIMEOUT_MS).
COACH_FAST_MS=5000
# Keep MOTION_WH resumed by querying it every N ms (it auto-suspends after 300 s).
# 240000 = every 4 min. The warehouse is billed while resumed: set this for demo time only. 0 = off.
WAREHOUSE_KEEPWARM_MS=0
# One tiny Cortex COMPLETE at startup so the first real coach card isn't a cold start.
CORTEX_WARMUP=1

# --- Front-end contract ------------------------------------------------------------------------
# The front end sends peak_velocity in shoulder-widths/second; this converts it to m/s.
SHOULDER_WIDTH_M=0.4

# --- Event ingestion (write-behind queue) -----------------------------------------------------
# Max events per POST /api/events request (larger -> 413)
EVENTS_MAX_BATCH=500
# Max rows per multi-row INSERT
EVENTS_INSERT_CHUNK=500
# Max events buffered while Snowflake is slow/down (beyond -> 503 queue_full)
EVENTS_MAX_QUEUE=50000
# How long POST /api/events waits for the INSERT before replying queued:true
EVENTS_ACK_WAIT_MS=50
EVENTS_RETRY_BASE_MS=250
EVENTS_RETRY_MAX_MS=15000
# After this many failed attempts a chunk is dropped, but only if Snowflake answers a ping
# (i.e. the data is bad, not the connection)
EVENTS_MAX_ATTEMPTS=8
# POST /api/session/end waits up to this long for the session's buffered events to be written
SESSION_END_FLUSH_WAIT_MS=5000
